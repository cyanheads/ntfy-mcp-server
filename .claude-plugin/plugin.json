{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "ntfy-mcp-server",
  "version": "2.3.5",
  "description": "Send, manage, and replay ntfy push notifications via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/ntfy-mcp-server#readme",
  "repository": "https://github.com/cyanheads/ntfy-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "ntfy", "notifications", "ai-agent", "typescript"],
  "mcpServers": {
    "ntfy-mcp-server": {
      "command": "npx",
      "args": ["-y", "ntfy-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
