# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=127.0.0.1           # HTTP host (default: 127.0.0.1)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_HTTP_MAX_BODY_BYTES=1048576  # Max request body bytes; 413 over limit, 0 disables (default: 1048576)
# MCP_PUBLIC_URL=                  # Public origin behind a TLS-terminating proxy (e.g. https://mcp.example.com)

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)
# MCP_REQUEST_STATE_KEY=            # Recommended for HTTP. >= 32 bytes (e.g. `openssl rand -base64 32`), the
                                    # same on every instance. Seals the requestState a handler returns — here,
                                    # the consent-record id the confirmation prompt on ntfy_manage_message and
                                    # gated publishes carries — bound to the caller for 900s; a forged,
                                    # tampered, or expired state is rejected (-32602 invalid_request_state)
                                    # before the handler runs. Unset, the gate still refuses any id it did not
                                    # mint, but reads whatever string the client sends. Stdio needs none.

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1
                                    # Consent records live here (600s TTL). in-memory is right for one process;
                                    # a multi-instance HTTP deployment needs storage every instance shares:
                                    # filesystem (on a shared volume), supabase, or cloudflare-d1 — never
                                    # cloudflare-kv, whose eventual consistency lets a replay outrun the delete.

# ── Session ──────────────────────────────────────────────────────────
MCP_SESSION_MODE=stateful           # auto | stateful | stateless (framework default: auto, which resolves to stateful).
                                    # This server requires stateful over HTTP: the consent prompt on
                                    # ntfy_manage_message and on a publish carrying email / call / a broadcast
                                    # or http action is a multi-round-trip request, and a 2025-era HTTP client
                                    # needs a live session for the SDK's legacy shim to complete it. src/index.ts
                                    # declares sessionMode require: 'stateful', so an HTTP start with stateless
                                    # fails at startup. Stdio ignores this setting.
# MCP_HTTP_RESUMABILITY=false       # SSE replay on a dropped stateful stream. Default: true.
                                    # Kill switch only — no effect on stateless serving.
# MCP_HTTP_RESUMABILITY_MAX_EVENTS=512   # Retained per session, oldest evicted first
# MCP_HTTP_RESUMABILITY_TTL_MS=300000    # How long a retained event stays replayable

# ── Memory ───────────────────────────────────────────────────────────
# MCP_GC_PRESSURE_INTERVAL_MS=0     # Opt-in forced Bun.gc(true) interval, ms (Bun only). Drains old-gen backlog
                                    # under sustained HTTP load (issue #50). Try 60000 if RSS grows. Default: 0.

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error
# MCP_LOG_RATE_LIMIT_THRESHOLD=10   # Max emissions per level+message per window; 0 disables
# MCP_LOG_RATE_LIMIT_WINDOW_MS=60000
# LOG_TOOL_FAILURE_PAYLOADS=false            # Log failed tool calls' arguments + result (key-name redaction only;
                                             # secrets in free-form values are kept). Reaches stderr, files, and OTLP
# LOG_TOOL_FAILURE_PAYLOAD_MAX_BYTES=16384   # Per-payload cap, UTF-8 bytes
# LOG_LLM_INTERACTIONS=false                 # Write full OpenRouter request/response bodies to interactions.log
                                             # instead of metadata (transcripts can carry PII and secrets)

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # OTLP base URL (e.g., http://localhost:4318); traces → /v1/traces, metrics → /v1/metrics
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=        # Overrides the base for traces; used as-is
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=       # Overrides the base for metrics; used as-is
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=          # Opt-in log export (e.g., http://localhost:4318/v1/logs); the base never enables it

# ── Server-specific (ntfy) ───────────────────────────────────────────
# Two configuration shapes — pick one. NTFY_SERVERS wins when both are set.
#
# (A) Multi-server registry — JSON array, first entry is the default base.
#     Auth is scoped per-entry; per-call `base_url` overrides that match a
#     registered base forward that entry's auth, anything else goes out
#     unauthenticated.
# NTFY_SERVERS=[{"baseUrl":"https://ntfy.sh"},{"baseUrl":"https://ntfy.example.com","authToken":"tk_..."}]
#
# (B) Single-server shorthand — used when NTFY_SERVERS is unset.
# NTFY_BASE_URL=https://ntfy.sh           # Base URL of the ntfy server, no trailing slash
# NTFY_AUTH_TOKEN=                        # Bearer access token (`tk_...`); mutually exclusive with NTFY_AUTH_USERNAME/PASSWORD
# NTFY_AUTH_USERNAME=                     # Basic auth username; required together with NTFY_AUTH_PASSWORD
# NTFY_AUTH_PASSWORD=                     # Basic auth password; required together with NTFY_AUTH_USERNAME
#
# Shared
# NTFY_DEFAULT_TOPIC=                     # Topic used when a tool call omits `topic`
# NTFY_REQUEST_TIMEOUT_MS=15000           # Per-request HTTP timeout (ms)
# NTFY_MAX_RETRIES=3                      # Max retry attempts for transient upstream failures (5xx, network, 429)
# NTFY_BLOCK_PRIVATE_HOSTS=false          # Require a per-call `base_url` override to resolve to a public address, and
                                          # stop following its redirects, unless it is one of the servers registered
                                          # above. Turn it on where callers you don't control can reach the server;
                                          # leave it off to keep pointing tool calls at a LAN ntfy.
